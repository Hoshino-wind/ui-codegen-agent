{
  "name": "ai-ui-production-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LayerDoc-first pipeline for turning AI UI visuals into editable, verifiable, project-ready engineering assets.",
  "scripts": {
    "build": "npm run build:lib && npm run build:app",
    "build:app": "vite build",
    "build:lib": "tsc -p tsconfig.json",
    "dev": "vite --host 127.0.0.1",
    "intake:png": "node dist/cli/intakePng.js",
    "pipeline:homepage": "node dist/cli/homepagePipeline.js",
    "export:project": "node dist/cli/exportProject.js",
    "verify:layerdoc": "node dist/cli/verifyLayerDoc.js",
    "test": "npm run build:lib && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.app.json"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "playwright": "^1.61.1",
    "typescript": "^5.8.3",
    "vite": "^8.1.0"
  },
  "dependencies": {
    "lucide-react": "^1.22.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
